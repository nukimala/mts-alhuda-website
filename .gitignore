# Kredensial & konfigurasi lokal
config/database.local.php
.env
.env.*

# Backup database
backup/
*.sql.gz
*.dump

# Log & cache
*.log
storage/logs/
storage/cache/
storage/sessions/

# Editor / OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Dependency
/vendor/
node_modules/

# Unggahan pengguna (jangan masuk repo)
public/uploads/*
# Kecuali: pelindung folder dan penanda folder kosong. Tanpa dua ini,
# folder unggahan di server baru tidak punya .htaccess dan berkas PHP
# yang lolos ke sana akan dieksekusi.
!public/uploads/.htaccess
!public/uploads/berita/
public/uploads/berita/*
!public/uploads/berita/.gitkeep

# Berkas besar di root (data mentah, bukan bagian kode)
*.drawio
